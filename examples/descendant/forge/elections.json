{
  "engine": "v0.1.31",
  "harnesses": {
    "claude-code": {
      "roots": {
        "global": "home/claude/skills",
        "hub": "home/claude/repos/hub/skills"
      },
      "unmanaged": {
        "global": [
          "synced"
        ]
      },
      "defaultTier": "workhorse",
      "tiers": {
        "lightweight": [
          {
            "model": "haiku",
            "effort": "high"
          }
        ],
        "workhorse": [
          {
            "model": "sonnet",
            "effort": "high"
          }
        ],
        "sota": [
          {
            "model": "opus",
            "effort": "high"
          }
        ],
        "session": [
          {}
        ]
      },
      "toolsRoot": "home/claude/tools",
      "toolsOpt": "~/.claude/tools",
      "tools": {
        "doc-section": {
          "version": "v1.0.0"
        }
      },
      "agentsRoot": "home/claude/agents",
      "agents": {
        "shim": {
          "version": "v1.0.0",
          "variants": {
            "lightweight": {
              "tier": "lightweight"
            },
            "lightweight-ro": {
              "tier": "lightweight",
              "disallowedTools": "Edit, Write, NotebookEdit"
            },
            "workhorse": {
              "tier": "workhorse"
            },
            "workhorse-ro": {
              "tier": "workhorse",
              "disallowedTools": "Edit, Write, NotebookEdit"
            },
            "sota": {
              "tier": "sota"
            },
            "sota-ro": {
              "tier": "sota",
              "disallowedTools": "Edit, Write, NotebookEdit"
            }
          }
        }
      },
      "elections": {
        "global": {
          "hello": {
            "version": "v1.0.0"
          },
          "systems-architect": {
            "version": "v1.0.0"
          },
          "prime-forge": {
            "version": "v1.0.0"
          }
        },
        "hub": {
          "pagma-update": {
            "version": "v1.0.0"
          },
          "pagma-uninstall": {
            "version": "v1.0.0"
          }
        }
      }
    }
  }
}
